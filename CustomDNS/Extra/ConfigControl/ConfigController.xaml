<Button x:Class="CustomDNS.Extra.ConfigControl.ConfigController"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            x:Name="Controller" Click="Controller_Click"
             xmlns:local="clr-namespace:CustomDNS.Extra.ConfigControl"
            HorizontalAlignment="Stretch"
             VerticalAlignment="Top" Cursor="Hand"
             Height="50" >
    <Button.Template>
        <ControlTemplate>

            <Border Background="{DynamicResource BoldestExtraColor}">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="90*"></ColumnDefinition>
                        <ColumnDefinition Width="10*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon x:Name="IconPic" Kind="Dns" Margin="10,0,10,0" Foreground="{Binding SolidOfIconEnebled, ElementName=Controller}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Margin="10" Grid.Column="1">
                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Style="{DynamicResource ConfigController_TitleStyle}" Text="{Binding DNSName, ElementName=Controller,Mode=TwoWay}"></TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Style="{DynamicResource ConfigController_SubtitleStyle}" Text="Preferred DNS: "></TextBlock>
                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Style="{DynamicResource ConfigController_SubtitleStyle}" Text="{Binding DNSValue1, ElementName=Controller,Mode=TwoWay}"></TextBlock>
                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Style="{DynamicResource ConfigController_SubtitleStyle}" Text="  |  "></TextBlock>
                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Style="{DynamicResource ConfigController_SubtitleStyle}" Text="Alternate DNS: "></TextBlock>
                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Style="{DynamicResource ConfigController_SubtitleStyle}" Text="{Binding DNSValue2, ElementName=Controller,Mode=TwoWay}"></TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="Delete" Grid.Column="2" Click="Delete_Click">
                        <Button.Template>
                            <ControlTemplate>

                                <materialDesign:PackIcon Kind="CloseThick" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimeryColor}"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </ControlTemplate>
    </Button.Template>

</Button>
