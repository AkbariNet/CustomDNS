<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Deffult Fonts-->

    <FontFamily x:Key="MainFont"  >pack://application:,,,/FileManager/Fonts/Inter.ttf #Inter</FontFamily>
    
    
    
    <!--Text Blocks-->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{DynamicResource MainFont}"></Setter>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MainFont}"></Setter>
        <Setter Property="FontWeight" Value="Medium"></Setter>
        <Setter Property="FontSize" Value="9px" ></Setter>
        <Setter Property="TextAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource PrimeryColor}"></Setter>
    </Style>

    <!--Combo Box Items-->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Red"></Setter>
    </Style>
    
    

    <!--Text Blocks / BOLD STYLE-->

    <Style TargetType="TextBlock" x:Key="BoldStyle">
        <Setter Property="FontFamily" Value="{DynamicResource MainFont}"></Setter>
        <Setter Property="FontWeight" Value="Medium"></Setter>
        <Setter Property="FontSize" Value="12px" ></Setter>
        <Setter Property="TextAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource PrimeryColor}"></Setter>
    </Style>

    
    <!--Text Boxes-->
    <Style TargetType="TextBox" x:Key="Round">
        <Setter Property="FontFamily" Value="{DynamicResource MainFont}"></Setter>
        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="Padding" Value="10"></Setter>
        <Setter Property="BorderBrush" Value="Transparent"></Setter>
        <Setter Property="BorderThickness" Value="0"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource LightestColor}"></Setter>
        <Style.Resources>
            <Style TargetType="{x:Type Border}">
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
        </Style.Resources>
    </Style>
    
    
    <!--ScrollBar-->


    <!--ForAll ScrollBar-->
    <Style TargetType="ScrollViewer">
        <Setter Property="Foreground" Value="{DynamicResource OrangeColor}"></Setter>

    </Style>
    <Style TargetType="ScrollBar"  >
        <Setter Property="SnapsToDevicePixels" Value="True"></Setter>
        <Setter Property="OverridesDefaultStyle" Value="True"></Setter>

        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="5"/>
                <Setter Property="Height" Value="auto"/>
                <Setter Property="Margin" Value="5,0,5,0"></Setter>
                <Setter Property="Template" Value="{DynamicResource VerticalScrollBar}"></Setter>
            </Trigger>

        </Style.Triggers>
    </Style>
    <ControlTemplate x:Key="VerticalScrollBar" TargetType="{x:Type ScrollBar}"  >
        <Grid  >
            <Grid.RowDefinitions>
                <RowDefinition Height="0"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="0"></RowDefinition>
            </Grid.RowDefinitions>
            <Border Visibility="Collapsed"
                        Grid.Row="1"
                        CornerRadius="10"
                        Margin="10"
                        Background="{DynamicResource OrangeColor}" BorderThickness="0" 
                        ></Border>
            <!--lineUpCommand-->
            <RepeatButton Visibility="Collapsed"
                        Grid.Row="0"
                        
                        Focusable="False"
                        Height="0"
                        Command="ScrollBar.LineUpCommand" BorderThickness="0" 
                        ></RepeatButton>


            <!--lineDownCommand-->
            <RepeatButton Visibility="Collapsed"
                        Grid.Row="2"
                        Focusable="False"
                        Height="0"
                        Command="ScrollBar.LineDownCommand"  BorderThickness="0" 
                        ></RepeatButton>
            <!--Track-->
            <Track  
                        Name="PART_Track"
                        Grid.Row="1" 
                        IsDirectionReversed="True" >
                <Track.DecreaseRepeatButton>
                    <!--Command="ScrollBar.PageUpCommand"-->
                    <RepeatButton Visibility="Collapsed"
                            Margin="3,2,3,2"   Background="{DynamicResource OrangeColor}"  BorderThickness="0"  ></RepeatButton>
                </Track.DecreaseRepeatButton>

                <!--Tomb-->
                <Track.Thumb>
                    <Thumb Foreground="{TemplateBinding  Property=Foreground}">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Border Background="{TemplateBinding  Property=Foreground}" CornerRadius="3" Visibility="Visible"></Border>
                                <ControlTemplate.Resources>
                                </ControlTemplate.Resources>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>

                <Track.IncreaseRepeatButton>
                    <RepeatButton Visibility="Collapsed"
                            Margin="3,2,3,2"  Background="White"  BorderThickness="0" ></RepeatButton>
                </Track.IncreaseRepeatButton>
            </Track>

        </Grid>
    </ControlTemplate>



    <!--#Exta-->
    <!--#Config Control-->
    <!--#Config Controller-->

    <!--Text Blocks / Title STYLE-->

    <Style TargetType="TextBlock" x:Key="ConfigController_TitleStyle">
        <Setter Property="FontFamily" Value="{DynamicResource MainFont}"></Setter>
        <Setter Property="FontWeight" Value="ExtraBold"></Setter>
        <Setter Property="FontSize" Value="12px" ></Setter>
        <Setter Property="TextAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource PrimeryColor}"></Setter>
    </Style>


    <!--Text Blocks / Subtitle STYLE-->

    <Style TargetType="TextBlock" x:Key="ConfigController_SubtitleStyle">
        <Setter Property="FontFamily" Value="{DynamicResource MainFont}"></Setter>
        <Setter Property="FontWeight" Value="Medium"></Setter>
        <Setter Property="FontSize" Value="8px" ></Setter>
        <Setter Property="TextAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource PrimeryColor}"></Setter>
    </Style>



</ResourceDictionary>