<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Colours-->
    
    
    <!--Primery-->
    <SolidColorBrush x:Key="PrimeryColor" Color="#E6E8E6"></SolidColorBrush>


    <!--Secound-->
    <SolidColorBrush x:Key="SecoundColor" Color="#CED0CE"></SolidColorBrush>


    <!--Boldest-->
    <SolidColorBrush x:Key="BoldestColor" Color="#191919"></SolidColorBrush>


    <!--Lightest-->
    <SolidColorBrush x:Key="LightestColor" Color="#FFF"></SolidColorBrush>


    <!--Orange-->
    <SolidColorBrush x:Key="OrangeColor" Color="#F15025"></SolidColorBrush>

    
    <!--Boldest-->
    <SolidColorBrush x:Key="BoldestExtraColor" Color="#212121"></SolidColorBrush>





</ResourceDictionary>